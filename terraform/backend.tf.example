# Optional remote state backend example.
# Copy to backend.tf only after creating the S3 bucket and reviewing requirements.
# Replace placeholders with literal values before running terraform init.

terraform {
  backend "s3" {
    bucket       = "REPLACE_WITH_YOUR_TERRAFORM_STATE_BUCKET"
    key          = "eks-argocd-gitops/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true
  }
}
